{
  "name": "convict-draw-claude-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local Excalidraw board that Claude can draw on and read through an MCP connector",
  "scripts": {
    "postinstall": "node -e \"require('fs').cpSync('node_modules/@excalidraw/excalidraw/dist/prod/fonts','web/public/fonts',{recursive:true})\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p .",
    "smoke": "tsx scripts/smoke-test.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3170"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "elkjs": "^0.12.0",
    "excalidraw-animate": "^0.7.2",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
